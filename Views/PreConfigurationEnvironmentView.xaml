<Window x:Class="OpenessApp.Views.PreConfigurationEnvironmentView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:viewModels="clr-namespace:OpenessApp.ViewModels"
        xmlns:models="clr-namespace:OpenessApp.Models"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:behaviors="clr-namespace:OpenessApp.Behaviors"
        mc:Ignorable="d"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="Pre-Configuration Modules"
        Height="350" Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        d:DataContext="{d:DesignInstance Type=viewModels:PreConfigurationEnvironmentViewModel, IsDesignTimeCreatable=True}">

    <!-- Dieses Verhalten schließt das Dialogfenster, sobald ViewModel.DialogResult true setzt -->
    <i:Interaction.Behaviors>
        <behaviors:WindowCloser DialogResult="{Binding DialogResult}" />
    </i:Interaction.Behaviors>

    <DockPanel LastChildFill="True" Margin="5">

        <!-- Siemens-Style Border-Rahmen -->
        <Border DockPanel.Dock="Top" Height="2" Background="#FF3B4461"/>
        <Border DockPanel.Dock="Bottom" Height="2" Background="#FF3B4461"/>
        <Border DockPanel.Dock="Left" Width="2" Background="#FF3B4461"/>
        <Border DockPanel.Dock="Right" Width="2" Background="#FF3B4461"/>

        <StackPanel>

            <!-- Pfad-Eingabe -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0"
               VerticalAlignment="Center"
               Content="Module path:"/>

                <TextBox Grid.Column="1"
                 Text="{Binding ModulePath, UpdateSourceTrigger=PropertyChanged}"
                 VerticalContentAlignment="Center"
                 MinWidth="300"/>

                <Button Grid.Column="2"
                Content="…"
                Width="30"
                Margin="5,0,0,0"
                Command="{Binding GetPathFromModulesAndOptionsCommand}"/>
            </Grid>

            <!-- Module-Liste -->
            <ListBox ItemsSource="{Binding ModulesAndOptions}"
               MinHeight="180"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               SelectionMode="Extended">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:TiaPortalModulesAndOptions}">
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                        Content="{Binding AssemblyName}"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}"/>

                            <TextBlock Grid.Column="1"
                         Text="{Binding EngineeringDll}"
                         VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="2"
                         Text="{Binding VersionInfo}"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Right"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Confirm Button -->
            <Button Content="Confirm"
              Height="30"
              Margin="0,10,0,0"
              HorizontalAlignment="Right"
              IsDefault="True"
              Command="{Binding ConfirmationCommand}"/>

        </StackPanel>
    </DockPanel>
</Window>
