<Window x:Class="OpenessApp.Views.PreSelectionAssemblyVersionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TIA-Version auswählen"
        SizeToContent="WidthAndHeight"
        MinWidth="300"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- TIA Version -->
        <TextBlock Text="Engineering-Version:"
                   VerticalAlignment="Center"
                   Margin="0,0,10,5"/>
        <ComboBox Grid.Column="1"
                  ItemsSource="{Binding EngineeringVersions}"
                  SelectedItem="{Binding SelectedEngineeringVersion}"
                  MinWidth="150"
                  Margin="0,0,0,5"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"/>

        <!-- API Version -->
        <TextBlock Grid.Row="1" Text="API-Version:"
                   VerticalAlignment="Center"
                   Margin="0,10,10,5"/>
        <ComboBox Grid.Row="1" Grid.Column="1"
                  ItemsSource="{Binding ApiVersions}"
                  SelectedItem="{Binding SelectedApiVersion}"
                  MinWidth="150"
                  Margin="0,10,0,5"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="OK"
                    Width="90"
                    Margin="0,0,10,0"
                    Click="Ok_Click"/>
            <Button Content="Abbrechen"
                    Width="90"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
